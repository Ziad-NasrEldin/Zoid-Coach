{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario-registry.schema.json",
  "title": "Zoid Coach end-user scenario registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "tracker_path",
    "tracker_sha256",
    "scenario_count",
    "scenarios"
  ],
  "properties": {
    "$schema": {
      "const": "scenario-registry.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "tracker_path": {
      "const": "docs/zoid-coach-product-scenario-tracker.md"
    },
    "tracker_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario_count": {
      "const": 666
    },
    "scenarios": {
      "type": "array",
      "minItems": 666,
      "maxItems": 666,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "section_number",
        "section_title",
        "item_index",
        "wording",
        "checkbox_state",
        "audit_status",
        "delivery_status",
        "disposition",
        "required_proof_classes",
        "affected_capability",
        "evidence_paths",
        "last_verified_commit",
        "last_verified_build",
        "audit_note",
        "tracker_line"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ZC-[0-9]{3}-[0-9]{3}$"
        },
        "section_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65
        },
        "section_title": {
          "type": "string",
          "minLength": 1
        },
        "item_index": {
          "type": "integer",
          "minimum": 1
        },
        "wording": {
          "type": "string",
          "minLength": 1
        },
        "checkbox_state": {
          "enum": ["checked", "unchecked"]
        },
        "audit_status": {
          "enum": [
            "Fully implemented",
            "Touches remaining",
            "Frontend only left",
            "Partially implemented",
            "Barely started",
            "Not implemented",
            "Blocked from verification"
          ]
        },
        "delivery_status": {
          "enum": [
            "fully_implemented",
            "touches_remaining",
            "frontend_only_left",
            "partially_implemented",
            "barely_started",
            "not_implemented",
            "blocked_from_verification"
          ]
        },
        "disposition": {
          "enum": [
            "required_now",
            "negative_invariant",
            "superseded_candidate",
            "deferred_guardrail"
          ]
        },
        "required_proof_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "unit_rule",
              "integration",
              "ui_automation",
              "accessibility",
              "installed_app_e2e",
              "live_runtime",
              "multi_day",
              "negative_invariant"
            ]
          }
        },
        "affected_capability": {
          "enum": [
            "onboarding_and_source_setup",
            "daily_planning",
            "task_execution",
            "behavior_truth_and_correction",
            "gaming_and_coaching",
            "review_and_learning",
            "settings",
            "privacy_and_data_control",
            "resilience_and_diagnostics",
            "product_quality",
            "end_to_end_acceptance",
            "release_scope_guardrail"
          ]
        },
        "evidence_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_. -]+(?:/[A-Za-z0-9_. -]+)+(?:\\.(?:swift|sh|plist|md|json|jsonl|sqlite))(?::[0-9]+(?:-[0-9]+)?)?$"
          }
        },
        "last_verified_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "last_verified_build": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "audit_note": {
          "type": "string"
        },
        "tracker_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
